# Copy to .env and adjust as needed. All values below are the defaults
# used when a variable is unset, except JWT_SECRET (see note below).

PORT=8080

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=queue_manager

# Secret used to sign admin session/2FA JWTs. If unset, the server
# generates a random one at startup and logs a warning — fine for local
# dev, but it means every admin session is invalidated on restart. Set a
# stable value in any environment where that matters:
#   openssl rand -hex 32
JWT_SECRET=

# Directory containing the admin frontend (index/static assets). Only
# needs changing if you run the binary from somewhere other than the
# project root.
WEB_DIR=web
